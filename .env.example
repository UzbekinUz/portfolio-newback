PORT=5000
# Bo'sh qoldirsangiz dev rejimda vaqtinchalik (xotiradagi) MongoDB ishlatiladi
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Ixtiyoriy: kontakt formasi xabarlarini Telegramga yuborish
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production uchun
NODE_ENV=production
# Saytning to'liq manzili (sitemap, canonical, Open Graph uchun)
SITE_URL=https://your-domain.uz
# SEO uchun standart til (uz | ru | en)
DEFAULT_LANG=uz
# Ixtiyoriy: rasmlarni Cloudinary'da saqlash (bo'sh bo'lsa lokal uploads/)
CLOUDINARY_URL=
